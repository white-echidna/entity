# This file is for unifying the coding style for different edtors and IDEs
# EditorConfig is awesome: https://editorconfig.org

# top-most EditorConfig
root = true

[*]
charset = utf-8
insert_final_newline = true

[*.json]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[{.clangd,.clang-tidy,.clang-format}]
indent_style = space
indent_size = 2

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4

[*.nix]
indent_style = space
indent_size = 2

[{*.cpp,*.hpp}]
indent_style = space
indent_size = 2
